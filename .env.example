# AIMHOP Tech - Environment Configuration
# Add your confidential or business specific values here.
# Note: For variables that need to be accessed by client components in Next.js,
# prefix them with NEXT_PUBLIC_

# Business WhatsApp Configuration (Country Code + 10 Digits, without +, -, or space)
# Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=919129680681

# Business WhatsApp Display Label for Call/WhatsApp widgets
# Example: +91 98765 43210
NEXT_PUBLIC_WHATSAPP_DISPLAY=+91 91296 80681

# Primary Business Contact Email
NEXT_PUBLIC_CONTACT_EMAIL=aimhoptechnology@gmail.com

# Business Location / Operational Headquarters
NEXT_PUBLIC_LOCATION=Uttar Pradesh, India
